# Copy to `.env.local` in this folder, paste your Alpaca keys, then restart `npm run dev`.
# `.env.local` is gitignored — never commit real keys.

# Same FastAPI server as Desktop/Apps/fiboflow (uvicorn, usually :8000). When set, the web app
# uses /account, /positions, /trades, /trade, /live-toggle, /auto-trade-toggle like the Expo app.
# NEXT_PUBLIC_FIBOFLOW_API_URL=http://127.0.0.1:8000

# Paper API keys (from https://app.alpaca.markets/paper/dashboard/overview )
NEXT_PUBLIC_ALPACA_PAPER_API_KEY=
NEXT_PUBLIC_ALPACA_PAPER_API_SECRET=

# Live API keys (from https://app.alpaca.markets/overview )
NEXT_PUBLIC_ALPACA_LIVE_API_KEY=
NEXT_PUBLIC_ALPACA_LIVE_API_SECRET=

# Optional: one pair used for both modes if paper and live share the same key (unusual).
# NEXT_PUBLIC_ALPACA_API_KEY=
# NEXT_PUBLIC_ALPACA_API_SECRET=
